{
  "name": "aksharacheck-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:pages": "tsc && vite build --mode pages",
    "deploy:pages": "npm run build:pages && npx --yes gh-pages -d dist -b gh-pages --dotfiles"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource-variable/anek-devanagari": "^5.3.0",
    "@fontsource-variable/anek-kannada": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  }
}
